<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">

      <section>
        <p><%= link_to "← 一覧へ戻る", posts_path %></p>
      
        <div class="d-flex justify-content-between">
          <h2>
            <%= @post.title %>
          </h2>
            
          <%= link_to "編集", edit_post_path(@post), class: "btn btn-primary p-2" %>
        </div>

        <div class="border rounded shadow-sm p-3 mt-3">
          <table class= "table table-bordered mt-4 schedule-table">
            <tr>
              <th class="table-light" style="width: 30%;">開始日</th>
              <td><%= @post.start_date.strftime("%Y/%m/%d") %></td>
            </tr>
            <tr>
              <th class="table-light">終了日</th>
              <td><%= @post.end_date.strftime("%Y/%m/%d") %></td>
            </tr>
            <tr>
              <th class="table-light">終日</th>
              <td><%= @post.all_day ? "○" : "" %></td>
            </tr>
            <tr>
              <th class="table-light">スケジュールメモ</th>
              <td><%= @post.body %></td>
            </tr>
          </table>
        </div>
      </section>
    </div>
  </div>
</div>

