<p>予定一覧</p>
<%= link_to "新規追加", new_post_path %>

<table>
  <tr>
    <th>ID</th>
    <th>タイトル</th>
    <th>開始日</th>
    <th>終了日</th>
    <th>終日</th>
    <th>更新日時</th>
  </tr>
  <% @posts.each do |post| %>
    <tr>
      <td><%= post.id %></td>
      <td><%= post.title %></td>
      <td><%= post.start_date.strftime("%Y/%m/%d") %></td>
      <td><%= post.end_date.strftime("%Y/%m/%d") %></td>
      <td><%= post.all_day ? "○" : "" %></td>
      <td><%= post.updated_at.strftime("%Y/%m/%d %H:%M") %></td>

      <td>
        <%= link_to "詳細", post_path(post) %>
        <%= link_to "編集", edit_post_path(post) %>
        <%= button_to "削除", post_path(post),
          method: :delete,
          data: { turbo_confirm: "本当に削除しますか？" } %> 
      </td>

    </tr>
  <% end %>

  </table>

  <footer>
    <p>予定合計 <%= @posts.count %>件</p>
    <p>本日の日付 <%= Date.current.strftime("%Y/%m/%d") %>
  </footer>
