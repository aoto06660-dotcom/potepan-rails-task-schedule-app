<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-10">

      <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="text-dark fs-3">予定一覧</h2>
        <%= link_to "新規追加", new_post_path, class: "btn btn-primary" %>
      </div>

      <div class="bg white border rounded shadow-sm">
          <table class="table table-striped table-hover schedule-table">
            <tr>
              <th>ID</th>
              <th>タイトル</th>
              <th>開始日</th>
              <th>終了日</th>
              <th>終日</th>
              <th>更新日時</th>
            </tr>
            <% @posts.each do |post| %>
              <tr>
                <td><%= post.id %></td>
                <td><%= post.title %></td>
                <td><%= post.start_date.strftime("%Y/%m/%d") %></td>
                <td><%= post.end_date.strftime("%Y/%m/%d") %></td>
                <td><%= post.all_day ? "○" : "" %></td>
                <td><%= post.updated_at.strftime("%Y/%m/%d %H:%M") %></td>

                <td>
                  <div class="d-flex gap-3">
                    <%= link_to "詳細", post_path(post), class:"btn btn-outline-primary btn-sm" %>
                    <%= link_to "編集", edit_post_path(post), class:"btn btn-outline-success btn-sm" %>
                    <%= button_to "削除", post_path(post),
                      method: :delete,
                      data: { turbo_confirm: "本当に削除しますか？" },
                      class: "btn btn-outline-danger btn-sm" %> 
                  </div>
                </td>

              </tr>
            <% end %>

          </table>
      </div>
      
      <footer class="d-flex justify-content-between align-items-center mt-4 mb-4 border rounded p-4 bg white border rounded shadow-sm">
        <p class="mb-0">予定合計 <%= @posts.count %>件</p>
        <p class="mb-0">本日の日付 <%= Date.current.strftime("%Y/%m/%d") %></p>
      </footer>
    </div>
  </div>
</div>   